# CampusPulse AI Environment Configuration Example

SECRET_KEY=campuspulse-insecure-key-demo-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# Set USE_MYSQL=True to connect to MySQL 8.x; if connection fails or USE_MYSQL=False, falls back to SQLite
USE_MYSQL=False
DB_NAME=campuspulse_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Weather API (Open-Meteo free endpoint, no key required)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# Campus Map Defaults (Latitude and Longitude of Campus Central Quad)
CAMPUS_LAT=12.9716
CAMPUS_LNG=77.5946
CAMPUS_NAME=CampusPulse Central University
